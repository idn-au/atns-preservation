PREFIX : <http://www.w3.org/ns/odrl/2/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX id: <http://id.loc.gov/vocabulary/identifiers/>
PREFIX ont: <http://www.w3.org/ns/odrl/2>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ont:
    a owl:Ontology ;
    owl:versionIRI <http://www.w3.org/ns/odrl/2/idn-0.1.0> ;
    owl:versionInfo "idn-0.1.0" ;
    skos:historyNote "This validator was adapted for the IDN's ID Catalogue project 2021 - 2026."@en ;
    schema:codeRepository "https://github.com/idn-au/atns-preservation"^^xsd:anyURI ;
    schema:copyrightHolder <https://linked.data.gov.au/org/idn> ;
    schema:copyrightNotice "(c) Indigenous Data Network, 2026" ;
    schema:copyrightYear "2026"^^xsd:gYear ;
    schema:creator <https://orcid.org/0000-0001-5640-3202> ;
    schema:dateCreated "2026-08-16"^^xsd:date ;
    schema:dateIssued "2099-08-16"^^xsd:date ;
    schema:dateModified "2026-08-16"^^xsd:date ;
    schema:description "OCRL SHACL validator adapted for the IDN Catalogue Profile."@en ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:name "ODRL validator for IDN Catalogue Profile"@en ;
    schema:publisher <https://linked.data.gov.au/org/idn> ;
.

<https://linked.data.gov.au/org/idn>
    a schema:Organization ;
    schema:name "Indigenous Data Network" ;
    schema:url "https://mspgh.unimelb.edu.au/centres-institutes/centre-for-health-equity/research-group/indigenous-data-network"^^xsd:anyURI ;
.

<https://orcid.org/0000-0001-5640-3202> a schema:Person ;
schema:name "Les Kneebone" ;
schema:email "les@kurawong.ai"^^xsd:anyURI ;
.

# Ranges
:datatypeRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :datatype ;
    sh:class rdfs:Datatype ;
rdfs:isDefinedBy ont: ;
.


:partyRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :assignee, :assigner ;
    sh:deactivated true ; # use only rdfs:domain/range?
    sh:class :Party ;
rdfs:isDefinedBy ont: ;
.
	
:actionRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :action, :includedIn, :implies ;
    sh:deactivated true ; # use only rdfs:domain/range?
    sh:class :Action ;
rdfs:isDefinedBy ont: ;
.
	
:targetRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :target ;
    sh:deactivated true ; # use only rdfs:domain/range?
    sh:class :Asset ;
rdfs:isDefinedBy ont: ;
.

:dutyRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :remedy, :duty, :consequence, :obligation ;
    sh:deactivated true ; # use only rdfs:domain/range?
    sh:class :Duty ;
rdfs:isDefinedBy ont: ;
.	

:rightOperandReferenceRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :rightOperandReference ;
    sh:nodeKind sh:IRI ;
rdfs:isDefinedBy ont: ;
.
	
# Remedy
:RemedyShape
    a sh:NodeShape ;
    sh:targetObjectsOf :remedy ;
    sh:class :Duty ;	
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "consequence property constraint" ; schema:description "Constraint on consequence property constraint."@en ;
    sh:path :consequence ;
        sh:maxCount 0 ;
    ] ;
rdfs:isDefinedBy ont: ;
.

# Policy
:PolicyShape
    a sh:NodeShape ;
    sh:targetClass :Policy ;
    sh:nodeKind sh:IRI ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "conflict property constraint" ; schema:description "Constraint on conflict property constraint."@en ;
    sh:path :conflict ;
        sh:class :ConflictTerm ;
        sh:maxCount 1 ;
    ] ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "profile property constraint" ; schema:description "Constraint on profile property constraint."@en ;
    sh:path :profile ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "permission / prohibition alternative path" ; schema:description "Constraint on permission / prohibition alternative path."@en ;
    sh:path [ 
            sh:alternativePath ( :permission :prohibition ) 
        ] ;
        sh:node :targetCardShape ;
    ] ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "permission / prohibition / obligation alternative path" ; schema:description "Constraint on permission / prohibition / obligation alternative path."@en ;
    sh:path [ 
            sh:alternativePath ( :permission :prohibition :obligation ) 
        ] ;
        sh:minCount 1 ;
    ] ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "property constraint" ; schema:description "Constraint on property constraint."@en ;
    sh:path [ sh:oneOrMorePath [ sh:inversePath :inheritFrom ]] ;
        sh:disjoint :inheritFrom
    ] ;
rdfs:isDefinedBy ont: ;
.
 
:targetCardShape 
    a sh:NodeShape ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "target property constraint" ; schema:description "Constraint on target property constraint."@en ;
    sh:path :target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
rdfs:isDefinedBy ont: ;
.

## Agreement
:AgreementShape
    a sh:NodeShape ;
    sh:targetClass :Agreement ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "permission / prohibition / obligation alternative path" ; schema:description "Constraint on permission / prohibition / obligation alternative path."@en ;
    sh:path [ 
            sh:alternativePath ( :permission :prohibition :obligation ) 
        ] ;
        sh:node :assignerMinShape ;
        sh:node :assigneeMinShape ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Agreement requirement shape"@en ;
schema:description "Assigner and assignee minimum requirements shape for an Agreement"@en ;
sh:message "At least one assigner and at least one assignee MUST be indicated for a Permission, Prohibition or Obligation arising from an Agreement"@en ;
.

## Offer
:OfferShape
    a sh:NodeShape ;
    sh:targetClass :Offer ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "permission / prohibition / obligation alternative path" ; schema:description "Constraint on permission / prohibition / obligation alternative path."@en ;
    sh:path [ 
            sh:alternativePath ( :permission :prohibition :obligation ) 
        ] ;
        sh:node :assignerMinShape ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Offer requirement shape" ;
schema:description "Assigner minimum requirements shape for an Offer"@en ;
sh:message "At least one assigner MUST be indicated for an Offer"@en ;
.
	
:assignerMinShape
    a sh:NodeShape ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "assigner property constraint" ; schema:description "Constraint on assigner property constraint."@en ;
    sh:path :assigner ;
        sh:minCount 1 ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Assigner minimum shape" ;
schema:description "Minimum count for an assigner shape" ;
sh:message "At least one assigner" ; 
.
 
:assigneeMinShape
    a sh:NodeShape ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "assignee property constraint" ; schema:description "Constraint on assignee property constraint."@en ;
    sh:path :assignee ;
        sh:minCount 1 ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Assignee minimum shape" ;
schema:description "Minimum count for an assignee shape" ;
sh:message "At least one assignee" ; 
.

# Rule

:RuleShape
    a sh:NodeShape ;
    sh:targetClass :Rule ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "action property constraint" ; schema:description "Constraint on action property constraint."@en ;
    sh:path :action ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "assignee property constraint" ; schema:description "Constraint on assignee property constraint."@en ;
    sh:path :assignee ;
        sh:maxCount 1 ;
    ] ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "assigner property constraint" ; schema:description "Constraint on assigner property constraint."@en ;
    sh:path :assigner ;
        sh:maxCount 1 ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Rule shape" ;
schema:description "Rule requirements for indicating an assigner, assignee and action"@en ;
schema:message "A Rule MUST indicated exactly one assigner, one assignee and one action" ;
.

## Prohibition
:ProhibitionShape
    a sh:NodeShape ;
    sh:targetClass :Prohibition ;
    sh:not [
        a sh:NodeShape ;
        sh:class :Permission ;
    ] ;
    sh:not [
        a sh:NodeShape ;
        sh:class :Duty ;
    ] ;
rdfs:isDefinedBy ont: ;
.

# Constraint	

:LogicConstraintShape
    a sh:NodeShape ;
    sh:targetObjectsOf :and ;         
    sh:targetObjectsOf :or ;          
    sh:targetObjectsOf :xone ;       
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "list-first property constraint" ; schema:description "Constraint on list-first property constraint."@en ;
    sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class :Constraint ;
    ] ;
rdfs:isDefinedBy ont: ;
.

:ConstraintShape
    a sh:NodeShape ;
    sh:targetClass :Constraint ;              
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "operator property constraint" ; schema:description "Constraint on operator property constraint."@en ;
    sh:path :operator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;       
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "datatype property constraint" ; schema:description "Constraint on datatype property constraint."@en ;
    sh:path :datatype ;
        sh:maxCount 1 ;
    ] ;  
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "unit property constraint" ; schema:description "Constraint on unit property constraint."@en ;
    sh:path :unit ;
        sh:maxCount 1 ;
    ] ;  
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "status property constraint" ; schema:description "Constraint on status property constraint."@en ;
    sh:path :status ;
        sh:maxCount 1 ;
    ] ;  	
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "leftOperand property constraint" ; schema:description "Constraint on leftOperand property constraint."@en ;
    sh:path :leftOperand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:xone ( :rightOperandSingleShape :rightOperandRefShape ) ;
rdfs:isDefinedBy ont: ;
.
 
:rightOperandSingleShape
    a sh:NodeShape ;          
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "rightOperand property constraint" ; schema:description "Constraint on rightOperand property constraint."@en ;
    sh:path :rightOperand ;
        sh:minCount 1 ;
    ] ;
rdfs:isDefinedBy ont: ;
.
 
:rightOperandRefShape 
    a sh:NodeShape ;          
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "rightOperandReference property constraint" ; schema:description "Constraint on rightOperandReference property constraint."@en ;
    sh:path :rightOperandReference ;
        sh:minCount 1 ;
    ] ;
rdfs:isDefinedBy ont: ;
.

# Party
:PartyCollectionShape
    a sh:NodeShape ;
    sh:targetClass :PartyCollection ;
    sh:xone ( :WithRefinementShape :WithoutRefinementShape ) ;
rdfs:isDefinedBy ont: ;
.
 
:WithRefinementShape
    a sh:NodeShape ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "source property constraint" ; schema:description "Constraint on source property constraint."@en ;
    sh:path :source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "refinement property constraint" ; schema:description "Constraint on refinement property constraint."@en ;
    sh:path :refinement ;
        sh:minCount 1 ;
    ] ;
rdfs:isDefinedBy ont: ;
.	
 
:WithoutRefinementShape
    a sh:NodeShape ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "source property constraint" ; schema:description "Constraint on source property constraint."@en ;
    sh:path :source ;
        sh:maxCount 0 ;
    ] ;
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "refinement property constraint" ; schema:description "Constraint on refinement property constraint."@en ;
    sh:path :refinement ;
        sh:maxCount 0 ;
    ] ;
rdfs:isDefinedBy ont: ;
.

# Asset
:AssetCollectionShape
    a sh:NodeShape ;
    sh:targetClass :AssetCollection ;
    sh:xone ( :WithRefinementShape :WithoutRefinementShape ) ;
rdfs:isDefinedBy ont: ;
.
 

# Action
:ActionShape
    a sh:NodeShape ;
    sh:targetClass :Action ;              
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "includedIn property constraint" ; schema:description "Constraint on includedIn property constraint."@en ;
    sh:path :includedIn ;
        sh:minCount 1 ;
    ] ;
rdfs:isDefinedBy ont: ;
.

# End of odrl-idn.ttl
