PREFIX : <http://www.w3.org/ns/odrl/2/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX id: <http://id.loc.gov/vocabulary/identifiers/>
PREFIX ont: <http://www.w3.org/ns/odrl/2>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ont:
    a owl:Ontology ;
    owl:versionIRI <http://www.w3.org/ns/odrl/2/idn-0.1.0> ;
    owl:versionInfo "idn-0.1.0" ;
    skos:historyNote "This validator was adapted for the IDN's ID Catalogue project 2021 - 2026."@en ;
    schema:codeRepository "https://github.com/idn-au/atns-preservation"^^xsd:anyURI ;
    schema:copyrightHolder <https://linked.data.gov.au/org/idn> ;
    schema:copyrightNotice "(c) Indigenous Data Network, 2026" ;
    schema:copyrightYear "2026"^^xsd:gYear ;
    schema:creator <https://orcid.org/0000-0001-5640-3202> ;
    schema:dateCreated "2026-08-16"^^xsd:date ;
    schema:dateIssued "2099-08-16"^^xsd:date ;
    schema:dateModified "2026-08-16"^^xsd:date ;
    schema:description "OCRL SHACL validator adapted for the IDN Catalogue Profile."@en ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:name "ODRL validator for IDN Catalogue Profile"@en ;
    schema:publisher <https://linked.data.gov.au/org/idn> ;
.

<https://linked.data.gov.au/org/idn>
    a schema:Organization ;
    schema:name "Indigenous Data Network" ;
    schema:url "https://mspgh.unimelb.edu.au/centres-institutes/centre-for-health-equity/research-group/indigenous-data-network"^^xsd:anyURI ;
.

<https://orcid.org/0000-0001-5640-3202> a schema:Person ;
schema:name "Les Kneebone" ;
schema:email "les@kurawong.ai"^^xsd:anyURI ;
.

# Ranges
:datatypeRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :datatype ;
    sh:class rdfs:Datatype ;
rdfs:isDefinedBy ont: ;
schema:name "Datatype range shape" ;
.


:partyRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :assignee, :assigner ;
    sh:deactivated true ; # use only rdfs:domain/range?
    sh:class :Party ;
rdfs:isDefinedBy ont: ;
schema:name "Party range shape" ;
.
	
:actionRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :action, :includedIn, :implies ;
    sh:deactivated true ; # use only rdfs:domain/range?
    sh:class :Action ;
rdfs:isDefinedBy ont: ;
schema:name "Action range shape" ;
.
	
:targetRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :target ;
    sh:deactivated true ; # use only rdfs:domain/range?
    sh:class :Asset ;
rdfs:isDefinedBy ont: ;
schema:name "Target range shape" ;
.

:dutyRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :remedy, :duty, :consequence, :obligation ;
    sh:deactivated true ; # use only rdfs:domain/range?
    sh:class :Duty ;
rdfs:isDefinedBy ont: ;
schema:name "Duty range shape" ;
.	

:rightOperandReferenceRangeShape
    a sh:NodeShape ;
    sh:targetObjectsOf :rightOperandReference ;
    sh:nodeKind sh:IRI ;
rdfs:isDefinedBy ont: ;
schema:name "Right operand reference range shape" ;
.
	
# Remedy
:RemedyShape
    a sh:NodeShape ;
    sh:targetObjectsOf :remedy ;
    sh:class :Duty ;	
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "consequence property constraint" ; schema:description "Constraint on consequence property constraint."@en ;
    sh:path :consequence ;
        sh:maxCount 0 ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Remedy shape" ;
.

# Policy
:PolicyShape
    a sh:NodeShape ;
    sh:targetClass :Policy ;
    sh:nodeKind sh:IRI ;
    sh:property 
        [ a sh:PropertyShape; 
        skos:prefLabel "conflict property constraint" ; 
        schema:description "Constraint on conflict property constraint."@en ;
        sh:path :conflict ;
        sh:class :ConflictTerm ;
        sh:maxCount 1 ;
        ] ;
    sh:property 
        [ a sh:PropertyShape;
        skos:prefLabel "profile property constraint" ; 
        schema:description "Constraint on profile property constraint."@en ;
        sh:path :profile ;
        sh:nodeKind sh:IRI ;
        ] ;
    sh:property 
        [ a sh:PropertyShape; 
        skos:prefLabel "permission / prohibition alternative path" ; schema:description "Constraint on permission / prohibition alternative path."@en ;
        sh:path [ 
            sh:alternativePath ( :permission :prohibition ) 
                ] ;
        sh:node :targetCardShape ;
        ] ;
    sh:property 
        [ a sh:PropertyShape; 
        skos:prefLabel "permission / prohibition / obligation alternative path" ; schema:description "Constraint on permission / prohibition / obligation alternative path."@en ;
        sh:path [ 
            sh:alternativePath ( :permission :prohibition :obligation ) 
                ] ;
        sh:minCount 1 ;
        ] ;
    sh:property 
        [ a sh:PropertyShape; 
        skos:prefLabel "property constraint" ; 
        schema:description "Constraint on property constraint."@en ;
        sh:path [ sh:oneOrMorePath [ sh:inversePath :inheritFrom ]] ;
        sh:disjoint :inheritFrom
        ] ;
rdfs:isDefinedBy ont: ;
schema:name "Remedy node shape" ;
.
 
:targetCardShape 
    a sh:NodeShape ;
    sh:property 
        [ a sh:PropertyShape; 
        skos:prefLabel "target property constraint" ; 
        schema:description "Constraint on target property"@en ;
        sh:path :target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ] ;
rdfs:isDefinedBy ont: ;
schema:name "Target card shape" ;
.

## Agreement

:AgreementShape
    a sh:NodeShape ;
    sh:targetClass :Agreement ;
    sh:property
        [ a sh:PropertyShape; 
        skos:prefLabel "Agreement assigner and assignee shape" ; 
        schema:description "Constraint on permission, prohibition, obligation alternative path properties for Agreement class."@en ;
        sh:message "At least one assigner and at least one assignee MUST be indicated for a Permission, Prohibition or Obligation arising from an Agreement"@en ; 
    sh:path [ 
            sh:alternativePath ( :permission :prohibition :obligation ) 
        ] ;
        sh:node :assignerMinShape ;
        sh:node :assigneeMinShape ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Agreement node shape"@en ;
schema:description "Agreement shape"@en ;
.

## Offer

:OfferShape
    a sh:NodeShape ;
    sh:targetClass :Offer ;
    sh:property 
        [ a sh:PropertyShape ;
        skos:prefLabel "Offer assigner shape" ; 
        schema:description "Constraint on permission, prohibition and obligation properties for an Offer"@en ;
        sh:message "At least one assigner MUST be indicated for a Permission, Prohibition or Obligation arising from an Agreement"@en ;
    sh:path [ 
            sh:alternativePath ( :permission :prohibition :obligation ) 
            ] ;
        sh:node :assignerMinShape ;
        ] ;
rdfs:isDefinedBy ont: ;
schema:name "Offer shape" ;
schema:description "Assigner minimum requirements shape for an Offer"@en ;
.
	
:assignerMinShape
    a sh:NodeShape ;
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "Assigner property constraint" ; 
        schema:description "Assigner property constraint."@en ;
        sh:path :assigner ;
        sh:minCount 1 ;
        ] ;
rdfs:isDefinedBy ont: ;
schema:name "Assigner minimum shape" ;
schema:description "Minimum count for an assigner shape" ;
sh:message "At least one assigner" ; 
.
 
:assigneeMinShape
    a sh:NodeShape ;
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "Assignee property constraint" ; 
        schema:description "Assignee property constraint."@en ;
        sh:path :assignee ;
        sh:minCount 1 ;
        ] ;
rdfs:isDefinedBy ont: ;
schema:name "Assignee minimum shape" ;
schema:description "Minimum count for an assignee shape" ;
sh:message "At least one assignee" ; 
.

# Rule

:RuleShape
    a sh:NodeShape ;
    sh:targetClass :Rule ;
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "action property constraint" ; 
        schema:description "Constraint on action property constraint."@en ;
        sh:path :action ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Rule MUST indicate exactly one action" ;
        ] ;
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "assignee property constraint" ; 
        schema:description "Constraint on assignee property constraint."@en ;
        sh:path :assignee ;
        sh:maxCount 1 ;
        sh:message "A Rule MUST indicate at least one assignee" ;
        ] ;
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "assigner property constraint" ; 
        schema:description "Constraint on assigner property constraint."@en ;
        sh:path :assigner ;
        sh:maxCount 1 ;
        sh:message "A Rule MUST indicate at least one assigner" ;
        ] ;
rdfs:isDefinedBy ont: ;
schema:name "Rule shape" ;
schema:description "Rule node shape for indicating an Assigner, Assignee and Action"@en ;
sh:message "A Rule MUST indicate at least one assigner, at least one assignee and exactly one action" ;
.

## Prohibition
:ProhibitionShape
    a sh:NodeShape ;
    sh:targetClass :Prohibition ;
    sh:not [
        a sh:NodeShape ;
        sh:class :Permission ;
        sh:message "Prohibition is disjoint with Permission" ;
    ] ;
    sh:not [
        a sh:NodeShape ;
        sh:class :Duty ;
        sh:message "Prohibition is disjoint with Duty" ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Prohibition shape" ;
schema:description " " ;
.

# Constraint	

:LogicConstraintShape
    a sh:NodeShape ;
    sh:targetObjectsOf :and ;         
    sh:targetObjectsOf :or ;          
    sh:targetObjectsOf :xone ;       
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "list-first property constraint" ; 
        schema:description "Constraint on list-first property constraint."@en ;
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class :Constraint ;
        ] ;
rdfs:isDefinedBy ont: ;
schema:name "Logic constraint shape" ;
schema:description " " ;
.

:ConstraintShape
    a sh:NodeShape ;
    sh:targetClass :Constraint ;              
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "Operator property shape" ; 
        schema:description "Constraint on operator property constraint."@en ;
        sh:path :operator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Constraint MUST indicate exactly one operator" ;
        ] ;       
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "Datatype property shape" ; 
        schema:description "Constraint on datatype property constraint."@en ;
        sh:path :datatype ;
        sh:maxCount 1 ;
        sh:message "A Constraint MUST indicate one datatype at most" ;
    ] ;  
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "Unit property shape" ; 
        schema:description "Constraint on unit property constraint."@en ;
        sh:path :unit ;
        sh:maxCount 1 ;
        sh:message "A Constraint MUST indicate one unit at most" ;
    ] ;  
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "Status property shape" ; 
        schema:description "Constraint on status property constraint."@en ;
        sh:path :status ;
        sh:maxCount 1 ;
        sh:message "A Constraint MUST indicate one status at most" ;
    ] ;  	
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "leftOperand property constraint" ; 
        schema:description "Constraint on leftOperand property constraint."@en ;
        sh:path :leftOperand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Constraint MUST indicate exactly one left operand" ;
    ] ;
    sh:xone ( :rightOperandSingleShape :rightOperandRefShape ) ;
rdfs:isDefinedBy ont: ;
schema:name "Constraint shape" ;
schema:description "A Constraint shape indicating exclusive OR rules for right-operand and reference properties" ;
.
 
:rightOperandSingleShape
    a sh:NodeShape ;          
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "rightOperand property constraint" ; 
        schema:description "Constraint on rightOperand property."@en ;
        sh:path :rightOperand ;
        sh:minCount 1 ;
        sh:message "At least one right operand reference" ; 
        ] ;
rdfs:isDefinedBy ont: ;
schema:name "Right Operand Single Shape" ;
schema:description "Right Operand Single Shape indicating counts for a Constraint " ;
.
 
:rightOperandRefShape 
    a sh:NodeShape ;          
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "rightOperandReference property constraint" ; 
        schema:description "Constraint on rightOperandReference property."@en ;
        sh:path :rightOperandReference ;
        sh:minCount 1 ;
        sh:message "At least one right operand reference" ; 
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Right Operand Reference Shape" ;
schema:description "Right Operand Reference Shape indicating counts for a Constraint " ;
.

# Party
:PartyCollectionShape
    a sh:NodeShape ;
    sh:targetClass :PartyCollection ;
    sh:xone ( :WithRefinementShape :WithoutRefinementShape ) ;
rdfs:isDefinedBy ont: ;
schema:name "Party collection shape" ;
schema:description " " ;

.
 
:WithRefinementShape
    a sh:NodeShape ;
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "source property constraint" ; 
        schema:description "Constraint on source property constraint."@en ;
        sh:path :source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "At least one source" ;
        ] ;
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "refinement property constraint" ; 
        schema:description "Minimum count on refinement property."@en ;
        sh:path :refinement ;
        sh:minCount 1 ;
        sh:message "At least one refinement" ;
        ] ;
rdfs:isDefinedBy ont: ;
schema:name "With refinement node sape" ;
schema:description "Minimum counts for a source and refinement" ;
.	
 
:WithoutRefinementShape
    a sh:NodeShape ;
    sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "source property constraint" ; 
        schema:description "Constraint on source property constraint."@en ;
        sh:path :source ;
        sh:maxCount 0 ;
        sh:message "Exactly zero refinement" ;
        ] ;
        sh:property 
        [ a sh:PropertyShape ; 
        skos:prefLabel "refinement property constraint" ; 
        schema:description "Constraint on refinement property constraint."@en ;
    sh:path :refinement ;
        sh:maxCount 0 ;
        sh:message "Exactly zero source" ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Without refinement shape" ;
schema:description "Without refinement or source shape" ;
.

# Asset
:AssetCollectionShape
    a sh:NodeShape ;
    sh:targetClass :AssetCollection ;
    sh:xone ( :WithRefinementShape :WithoutRefinementShape ) ;
rdfs:isDefinedBy ont: ;
.
 

# Action
:ActionShape
    a sh:NodeShape ;
    sh:targetClass :Action ;              
    sh:property [ rdfs:isDefinedBy ont: ; skos:prefLabel "includedIn property constraint" ; schema:description "Constraint on includedIn property constraint."@en ;
    sh:message "An Action MUST indicate at least one includedIn object" ;

    sh:path :includedIn ;
        sh:minCount 1 ;
    ] ;
rdfs:isDefinedBy ont: ;
schema:name "Action includedIn shape" ;
schema:description "Action node shape" ;
.

# End of odrl-idn.ttl
