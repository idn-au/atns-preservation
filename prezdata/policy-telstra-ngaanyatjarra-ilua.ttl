    schema:citation
        <https://data.idnau.org/pid/nntt/WI2004-006> ,
        idn-resource:dd9b004b-1c22-5b53-8381-bd93760ee922 ;
    schema:conditionsOfAccess "Public"@en ;
    schema:dateCreated "2026-07-30"^^xsd:date ;
    schema:description "A demonstration ODRL interpretation of the Telstra Ngaanyatjarra Indigenous Land Use Agreement. It uses public ATNS and IDN reference data to demonstrate navigation between an agreement record, a policy expression, signatory parties and the registered agreement area. It is not an authoritative transcription of the legal agreement."@en ;
    schema:keywords "Demo" ;
    schema:dateModified "2026-08-13"^^xsd:date ;
    schema:name "Telstra Ngaanyatjarra ILUA — demonstration ODRL Agreement"@en ;
.

