idn-policy:telstra-ngaanyatjarra-ilua
    a
        odrl:Agreement ,
        schema:CreativeWork ;
    dcterms:conformsTo <https://www.w3.org/TR/odrl-model/> ;
    dcterms:created "2026-07-30"^^xsd:date ;
