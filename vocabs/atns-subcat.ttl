atns-subcat:96ed4893-3cbb-55ad-8320-7a41fca2ccc6
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200924105031/https://atns.net.au/subcategory.asp?subcategoryid=70> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Respondent(s) in a native title or related case before the Federal Court of Australia."@en ;
