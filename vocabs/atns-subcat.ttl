    skos:topConceptOf cs: ;
.

atns-subcat:f005f1b8-394e-56eb-9c31-20fe08cc3f42
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20070901075716/http://www.atns.net.au/subcategory.asp?subcategoryID=76> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The government of a Territory of Australia. The Northern Territory of Australia was established under the Northern Territory (Self-Government) Act 1978 , a Commonwealth Government Act of Parliament, while the Australian Capital Territory (ACT) Government was established in 1989."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "76"^^xsd:token ;
    skos:prefLabel "Territory Government"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:330fef0d-52e9-5598-8ab1-509cd921aac1
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20070902033444/http://www.atns.net.au/subcategory.asp?subcategoryid=77> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A Joint Venture Agreement is a commercial agreement creating a business partnership whereby the two or more parties each take up part ownership of a commercial venture."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "77"^^xsd:token ;
    skos:prefLabel "Joint Venture Agreement"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:d811f588-0526-5f2b-be26-8c2f3f8f1abc
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200923132957/https://atns.net.au/subcategory.asp?subcategoryid=78> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A body which represents the interests of a larger group or groups."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "78"^^xsd:token ;
    skos:prefLabel "Representative Body"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:a6c25fbf-fc85-500f-b84e-fd99fa599993
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140125204501/http://atns.net.au/subcategory.asp?subcategoryID=79> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A Convention is a binding agreement between states or nations; used synonymously with Treaty and Covenant. Conventions are stronger than Declarations because they are legally binding on governments that have signed them. When the UN General Assembly adopts a Convention, it creates international norms and standards. Once a Convention is adopted by the UN General Assembly, Member States can then ratify the Convention, promising to uphold it. Governments that violate the standards set forth in a Convention can then be censured by the UN. In Australia, treaty obligations are only recognised by courts as binding where they have been enacted by domestic legislation."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "79"^^xsd:token ;
    skos:prefLabel "Convention"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:e76f87e0-b8e3-5926-84b7-228c7fad9c7c
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20150325192439/http://atns.net.au/subcategory.asp?subcategoryid=80> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A legally binding agreement between two or more sovereign governments."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "80"^^xsd:token ;
    skos:prefLabel "Treaty (International)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:72a9c179-74f7-5b36-8f3a-0a46835c636f
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200925094045/https://atns.net.au/subcategory.asp?subcategoryID=81> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A Declaration is a formal or public statement or document stating agreed upon standards which is not legally binding."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "81"^^xsd:token ;
    skos:prefLabel "Declaration"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:75aa5456-8d13-506b-979c-bc34a8bd0a97
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103416/http://atns.net.au/subcategory.asp?subcategoryid=82> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A Deed of Settlement contains the fine detail of a settlement and is initialled by the Crown and the claimant negotiators. Once ratified by the wider claimant group, the final Deed of Settlement is drawn up and signed by the parties, at which time it becomes binding."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "82"^^xsd:token ;
    skos:prefLabel "Deed of Settlement (New Zealand)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:cac0a6f7-3a5e-508f-a1d4-c453fb671f9c
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20201029024718/https://atns.net.au/subcategory.asp?subcategoryID=83> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A publicly elected body which has governing authority over a political unit."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "83"^^xsd:token ;
    skos:prefLabel "Government"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:fce7d633-05fc-5e3e-8605-0cad9866c612
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103618/http://atns.net.au/subcategory.asp?subcategoryID=84> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Regional agreements are made between Indigenous communities and other organisations, usually government and/or industry. Regional agreements can be used to organise policies, politics, administration and/or public services for or by an Indigenous people in a defined, frequently large, territory of land, or land and sea. Regional agreements can be legally enforceable as contracts."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "84"^^xsd:token ;
    skos:prefLabel "Regional Agreement"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:848b1af9-95b3-5332-90e1-1383bd4e0da7
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The ATNS subcategory 'Native Title Representative Body (NTRB)'."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:inScheme cs: ;
    skos:notation "85"^^xsd:token ;
    skos:prefLabel "Native Title Representative Body (NTRB)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:b5a1f0b8-fda5-5c21-9210-53b047121dfd
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20070901081117/http://www.atns.net.au/subcategory.asp?subcategoryID=86> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The indigenous people of Canada who are not Inuit or Métis."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "86"^^xsd:token ;
    skos:prefLabel "First Nations People of Canada"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:b4d0936c-867c-53c4-b8ca-dad372cb8c0c
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20201029022700/https://atns.net.au/subcategory.asp?subcategoryID=87> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A party to a voluntary agreement about use and management of land and waters. May include one or more native title groups, government or private enterprise."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "87"^^xsd:token ;
    skos:prefLabel "Party to an Indigenous Land Use Agreement"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:3c896846-bc0f-53fa-82a8-faeedb9f0f2a
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140125204625/http://atns.net.au/subcategory.asp?subcategoryID=88> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typically a regional and popularly elected Aboriginal government which may have jurisdiction over law-making, education, health and social services. May be created pursuant to a self-government agreement."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "88"^^xsd:token ;
    skos:prefLabel "Canadian Aboriginal Government"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:668b60d9-b418-541f-9b99-af1f60fce728
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103727/http://atns.net.au/subcategory.asp?subcategoryID=89> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement between the Canadian federal government and a First Nation or Aboriginal group which provides for the reservation of lands under s 91 of the Constitution Act, 1867 . It provides for the exercise of jurisdiction by the group over the use and regulation of the lands. It is distinct from land claims or self-government agreements under the federal Comprehensive Claims Policy"@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "89"^^xsd:token ;
    skos:prefLabel "Land Governance Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:de48a4f0-1a8c-5488-bfa1-2fcef98c749d
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The ATNS subcategory 'Prescribed Body Corporate (PBC)'."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:inScheme cs: ;
    skos:notation "90"^^xsd:token ;
    skos:prefLabel "Prescribed Body Corporate (PBC)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:7d302f05-b6eb-5d8e-bff5-9fc313296b0c
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20110216102828/http://atns.net.au/subcategory.asp?subcategoryID=91> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An individual who runs a business in their own name which is not a limited company or a partnership."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "91"^^xsd:token ;
    skos:prefLabel "Sole Trader"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:f2c94516-72ba-5d2d-b9e9-1b80cf9850a1
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20201029103124/https://atns.net.au/subcategory.asp?subcategoryid=92> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An association or group of people who, as a group, are recognised as a legal entity separate from its members. An association may be incorporated under commonwealth, state or territory legislation. Once incorporated, an association has all the powers of an individual and is legally able to do things in its own name, such as own land, sign a lease, or appear in court."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "92"^^xsd:token ;
    skos:prefLabel "Incorporated Association"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:5256bda6-9db4-55ea-a7a8-c0b7773c6aa5
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160818/http://atns.net.au/subcategory.asp?subcategoryID=93> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An Agreement in Principle or Heads of Agreement outlines the preliminary elements of a settlement and includes basic details of the historical account of the claim as well as cultural and commercial redress. It may also include a proposed financial quantum of the settlement."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "93"^^xsd:token ;
    skos:prefLabel "Agreement in Principle / Heads of Agreement (New Zealand)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:84f0e035-49f3-5a4d-b092-77a17ebffa36
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140125204641/http://atns.net.au/subcategory.asp?subcategoryID=94> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The Governance Entity is the legal entity that is responsible to a wider claimant group to hold and manage settlement assets and exercise the forms of cultural redress that are provided for in the settlement package."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "94"^^xsd:token ;
    skos:prefLabel "Governance Entity (New Zealand)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:23587163-67a7-5fa1-8812-c75f795d32df
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103654/http://atns.net.au/subcategory.asp?subcategoryID=95> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement negotiated under the Canadian federal government’s Comprehensive Claims Policy, which clearly defines the rights of Aboriginal groups with respect to land and resources. Arrangements for self-government may also be included. The rights ensured by the agreement are constitutionally protected."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "95"^^xsd:token ;
    skos:prefLabel "Comprehensive Land Claims Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:0cd007d5-c58e-513b-862c-989968dcc81a
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160805/http://atns.net.au/subcategory.asp?subcategoryID=96> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement negotiated under the Canadian federal government’s Specific Claims Policy, which deals with outstanding treaty or other legal obligations. Such agreements are designed to achieve ‘full and final closure’ to grievances and to facilitate economic opportunities for First Nation governments."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "96"^^xsd:token ;
    skos:prefLabel "Specific Claims Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:2d2a94e9-c385-5c3d-b6fc-8bf2c230e7ef
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103710/http://atns.net.au/subcategory.asp?subcategoryID=97> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement often representing the first stage of negotiations of a land claims or self-government agreement. It may set out the details of the negotiation subject matter, the process and timetable for reaching an agreement-in-principle."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "97"^^xsd:token ;
    skos:prefLabel "Framework Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:49e870b8-b962-5785-a662-f506350ede50
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103648/http://atns.net.au/subcategory.asp?subcategoryID=98> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement setting out the objectives of, and elements to be included in a final agreement. The AIP does not create binding legal relations but paves the way for negotiation, and thereby functions as the basis of a final agreement."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "98"^^xsd:token ;
    skos:prefLabel "Agreement-in-Principle (AIP) (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:496640c9-a0b8-580b-9bba-459fe5fcc345
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103724/http://atns.net.au/subcategory.asp?subcategoryID=99> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement which sets out temporary arrangements intended to afford a measure of protection to Aboriginal interests while a final agreement is in the process of being negotiated. It protects the rights and benefits negotiated in the agreement-in-principle, and may recognise certain principles by which negotiations are to be guided. An interim measures agreement does not create binding legal relations but serves as a bridge to the negotiation of a final agreement."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "99"^^xsd:token ;
    skos:prefLabel "Interim Measures Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:e248c2dd-231c-5ac3-b046-96514d7b5cba
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160814/http://atns.net.au/subcategory.asp?subcategoryID=101> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Historical treaties in the Canadian context were first signed between the British Crown and First Nations. They impose a range of mutual obligations on signatory parties. Modern treaties take the form of land claims settlements which are constitutionally protected."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "101"^^xsd:token ;
    skos:prefLabel "Treaty (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:aadb9f87-ca50-5df2-a80b-6c2fad38cb3a
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160737/http://atns.net.au/subcategory.asp?subcategoryID=102> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Overlap or boundary agreements are negotiated between First Nations in the context of land claims negotiations where traditional territories overlap or intersect. Such agreements may cover both land and resource interests and may set out provisions relating to matters including the exercise of harvesting rights, delineation of shared use and claims areas, consultation and shared decision-making."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "102"^^xsd:token ;
    skos:prefLabel "Overlap/Boundary Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:d25c73be-9cb4-5d9b-9913-a32120c317b3
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140126160517/http://atns.net.au/subcategory.asp?subcategoryID=104> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The indigenous inhabitants of New Zealand."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "104"^^xsd:token ;
    skos:prefLabel "Maori People"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:1e638a55-1881-57c7-894d-fa95737ba14a
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20131029223303/http://www.atns.net.au/subcategory.asp?subcategoryID=105> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The Aboriginal Lands Trust (ALT) was established by the Western Australian Aboriginal Affairs Planning Authority Act 1972 (WA) (AAPA Act). The functions of the ALT (s23 AAPA Act) are primarily to acquire and hold land and to use and manage that land for the benefit of persons of Aboriginal descent."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "105"^^xsd:token ;
    skos:prefLabel "Aboriginal Lands Trust (Western Australia)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:3d174cb1-b9fa-5ba5-a4be-08e299ed27d2
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20131029202612/http://www.atns.net.au/subcategory.asp?subcategoryID=106> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The Aboriginal Lands Trust in South Australia is a statutory body under the Aboriginal Lands Trust Act 1966 (SA) (ALTA). The Lands Trust holds certain lands in trust for the economic and cultural benefit of the Aboriginal people of South Australia and may not sell any such land without the approval of both houses of Parliament."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "106"^^xsd:token ;
    skos:prefLabel "Aboriginal Lands Trust (South Australia)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:8a117369-cce0-5a2c-9d12-d3d13719a07e
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20170214233025/http://atns.net.au/subcategory.asp?subcategoryID=107> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An association based on the common interests of its members, individuals, or institutions. It has no government status or function and is not created by, nor is its agenda set or implemented by, a government."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "107"^^xsd:token ;
    skos:prefLabel "Non-Government Organisation (NGO)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:1682bda6-86ad-57ab-b605-73fb7027939d
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200921194826/https://atns.net.au/subcategory.asp?subcategoryID=108> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Shared Responsibility Agreements (SRAs) are agreements made between federal and state governments and Indigenous communities to provide discretionary funding in return for community obligations. Such agreements form part of the Council of Australian Governments' (COAG) original commitment to the Framework to Advance Reconciliation and the Commonwealth Government's whole of government initiatives. ‘Shared Responsibility’ is a key concept in these arrangements. SRAs set out what all partners to the agreement will contribute in order to develop effective and long-term changes for Indigenous communities. SRAs are developed with reference to local community priorities and ideas as to how these might be achieved."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "108"^^xsd:token ;
    skos:prefLabel "Shared Responsibility Agreement (SRA)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:599936e5-2a8b-5e7e-b079-88a9d0d0ef0c
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140125204538/http://atns.net.au/subcategory.asp?subcategoryID=109> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "ACCHOs operate in the metropolitan, regional, rural and remote areas of all States and Territories in Australia. ACCHOs are controlled by, and accountable to, Aboriginal people in those areas in which they operate. ACCHOs aim to deliver holistic, comprehensive and culturally appropriate health care to the community that controls it."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "109"^^xsd:token ;
    skos:prefLabel "Aboriginal Community Controlled Health Organisation (ACCHO)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:314b7fb0-5d8b-5ad1-afa1-ec0d99beee3b
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160749/http://atns.net.au/subcategory.asp?subcategoryID=110> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Political Accords are generally characterised by a cross-governmental approach to agreement making. This means that federal, provincial and Aboriginal governments or bodies are party to negotiations. An accord may establish a consultation process and subject matter of a proposed agreement, or may constitute a final agreement itself. Political accords often take place in the context of self-government negotiations."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "110"^^xsd:token ;
    skos:prefLabel "Political Accord (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:ad36943d-86a8-5484-8603-fdbb8581fa4e
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20201029015723/https://atns.net.au/subcategory.asp?subcategoryID=111> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The Indigenous inhabitants of mainland Australia, Tasmania and the Torres Strait Islands."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
