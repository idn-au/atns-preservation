atns-subcat:c43c7348-214e-5e4d-82fd-0ca183ec0745
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20201024180234/https://atns.net.au/subcategory.asp?subcategoryid=134> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The central government of a union of states in which sovereignty is divided between the central authority and the state authorities."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "134"^^xsd:token ;
    skos:prefLabel "Federal Government"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:c7a29999-091c-5086-b86d-fcd39ee1ff0b
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200925102017/https://atns.net.au/subcategory.asp?subcategoryID=135> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A proprietary (or private) company is limited to no more than 50 members and operates with restricted rights of transfer of shares. It can neither invite the general public to subscribe for its shares or debentures nor take deposits from the public. It is the most common form of company type."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "135"^^xsd:token ;
    skos:prefLabel "Proprietary Company"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:395f9c3d-1892-5865-a0a9-bc3dbcc40009
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20201029020908/https://atns.net.au/subcategory.asp?subcategoryID=136> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An Aboriginal corporation is a company owned by Indigenous Australians."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "136"^^xsd:token ;
    skos:prefLabel "Aboriginal Corporation"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:b8ac89d9-085b-56a9-b061-cde49e183bc4
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200922033909/https://atns.net.au/subcategory.asp?subcategoryid=137> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Aboriginal and Torres Strait Islander people who have made an application for the legal recognition of their native title rights and interests with the Federal Court and who have fulfilled the requirements to be included on the Register of Native Title Claims."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "137"^^xsd:token ;
    skos:prefLabel "Native Title Claimants (registered)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:05a69289-48e5-5043-9a4d-d45fc411b116
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20110216100719/http://atns.net.au/subcategory.asp?subcategoryID=138> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Land Trusts in the Northern Territory are statutory bodies under the Aboriginal Land Rights (Northern Territory) Act 1976 (Cth) (ALRA). Land Trusts hold the title to land handed back to the traditional Aboriginal owners under one of the mechanisms outlined in the ALRA. A Land Trust exercises certain functions in relation to the land held by it as set out in the ALRA, but cannot exercise those functions except in accordance with a direction given to it by the Land Council for the area in which that land is situated."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "138"^^xsd:token ;
    skos:prefLabel "Aboriginal Land Trust (Northern Territory)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:8e1b0c83-6505-5408-be21-8d1f74b43120
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200923115902/https://atns.net.au/subcategory.asp?subcategoryid=139> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A statutory body is one established by legislation."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "139"^^xsd:token ;
    skos:prefLabel "Statutory Body"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:6ffe90c2-95c9-51b5-a083-8c7d83b975ef
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200919214053/https://atns.net.au/subcategory.asp?subcategoryid=140> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "These can be legally binding agreements, however they are essentially ‘process agreements’, that is, they generally bind parties to adhere to certain processes rather than to substantive issues."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "140"^^xsd:token ;
    skos:prefLabel "Framework Agreement"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:107a111f-ec77-5bc3-8410-8bc0fade0403
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20150326094647/http://atns.net.au/subcategory.asp?subcategoryID=141> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A legal agreement between parties allowing one party to have a temporary interest in property, usually assuming most of the rights of the owner, and to use the property in accordance with the agreement. Leases will mostly have a date when they terminate, at which time the leased rights in the property return to the owner."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "141"^^xsd:token ;
    skos:prefLabel "Lease"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:1c5aa0a9-a1bc-59d1-a43d-51b12e376432
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20070902022448/http://www.atns.net.au/subcategory.asp?subcategoryid=142> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Local and regional land use and access agreements made between government and native title holders under the original section 21 of the Native Title Act 1993 (Cth) (unamended), where negotiations commenced or the agreement was finalised prior to the 1998 amendments to the Act."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "142"^^xsd:token ;
    skos:prefLabel "Section 21 Agreement (Native Title Act)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:6a2c747a-d581-55df-a79d-0e18378d44b4
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200921051047/https://atns.net.au/subcategory.asp?subcategoryid=143> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Aboriginal and Torres Strait Islander people who have made an application for the legal recognition of their native title rights and interests with the Federal Court and who have not fulfilled the requirements to be included on the Register of Native Title Claims."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "143"^^xsd:token ;
    skos:prefLabel "Native Title Claimants (unregistered)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:4a28e5d2-a7b3-5528-9ea6-595807ca3c08
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200921184930/https://atns.net.au/subcategory.asp?subcategoryID=144> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A land use agreement is made between two or more parties, where a party with rights in land grants permission for another party (who may also have rights in the same area of land) to use the land for a particular purpose, or in a particular way, in exchange for rights, goods or services."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "144"^^xsd:token ;
    skos:prefLabel "Land Use Agreement"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:27bf4e20-d996-5e23-bbd6-03284f4b24e4
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103516/http://atns.net.au/subcategory.asp?subcategoryID=145> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Agreements made on the open market for the exchange of goods and services, including the use of land. Although this category usually refers to binding contracts made between parties, it may also include any agreements made in the course of commerce, such as non-binding pre-contractual arrangements between parties. By convention this category does not include agreements made under statutory regimes dealing with native title rights, as those rights cannot be sold in the open market."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "145"^^xsd:token ;
    skos:prefLabel "Commercial Agreement"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:e25306cd-559a-5d5a-8a28-e66ca2c2323a
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103525/http://atns.net.au/subcategory.asp?subcategoryID=146> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement made with Aboriginal Traditional Owners for the grant of exploration licences over Aboriginal land, made under s 40 of the Aboriginal Land Rights (Northern Territory) Act 1976 (Cth) (the ALRA)."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "146"^^xsd:token ;
    skos:prefLabel "Exploration Agreement (Aboriginal Land Rights (Northern Territory) Act)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:5701ef5e-fe49-5289-b4da-3345efa1ce89
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103614/http://atns.net.au/subcategory.asp?subcategoryID=147> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement made with Aboriginal Traditional Owners for the grant of mining interests over Aboriginal land, made under s 46 of the Aboriginal Land Rights (Northern Territory) Act 1976 (Cth) (the ALRA)."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "147"^^xsd:token ;
    skos:prefLabel "Mining Agreement (Aboriginal Land Rights (Northern Territory) Act)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:f6be2b14-a012-5d67-a3b9-eec5a957c048
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200921191001/https://atns.net.au/subcategory.asp?subcategoryID=148> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The written document containing the terms of a lease."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "148"^^xsd:token ;
    skos:prefLabel "Memorandum of Lease"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:cb04592a-0221-592e-9bd2-7cfd7c515db8
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103529/http://atns.net.au/subcategory.asp?subcategoryID=149> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Exploration Agreements are made under the future act provisions of the Native Title Act 1993 (Cth) (not including Indigenous Land Use Agreements (ILUAs)). South Australia has its own provisions which comply with the regulations under the Native Title Act 1993 (Cth) for separate state regimes."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "149"^^xsd:token ;
    skos:prefLabel "Exploration Agreement (Native Title Act)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:89615198-37f5-5e14-91e6-a2ba2eb0af09
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20070902033248/http://www.atns.net.au/subcategory.asp?subcategoryid=150> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement between indigenous and non-indigenous parties for the joint management of land of traditional significance to the indigenous parties."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "150"^^xsd:token ;
    skos:prefLabel "Joint Management Agreement"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:51e799aa-68a2-5df5-b3b6-ce3837c24612
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20070911154925/http://www.atns.net.au/subcategory.asp?subcategoryID=151> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An Agreement which includes standard terms and conditions to be applied to a range of individual agreements all covering the same or similar issues and which is altered in certain respects to suit each particular situation."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "151"^^xsd:token ;
    skos:prefLabel "Template Agreement"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:f0427812-61d1-5004-b577-ac236a9c5c18
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103532/http://atns.net.au/subcategory.asp?subcategoryID=152> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An Agreement under which the National or State Governments agree to fund an Indigenous body for a particular purpose. Such an agreement will not be legally binding upon the government unless the legislation under which it is made does in fact bind the government."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "152"^^xsd:token ;
    skos:prefLabel "Funding Agreement"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:d95daea3-0353-524d-b9af-f7d0d06b878a
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The ATNS subcategory 'Report'."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:inScheme cs: ;
    skos:notation "153"^^xsd:token ;
    skos:prefLabel "Report"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:e9f2cbaa-5c3d-5a7e-a2de-427ab2fc804a
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20170214232859/http://atns.net.au/subcategory.asp?subcategoryID=154> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A Statement of Commitment or Intention can be made by any entity and is a non-binding instrument that relates to the achievement a particular aim or aims. Many relate to enhancing the reconciliation process with Aboriginal peoples and practical measures to that end."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "154"^^xsd:token ;
    skos:prefLabel "Statement of Commitment/Intention"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:d66b4fd1-9d0a-57fb-9a2c-d480e1cbc97f
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20170214233253/http://atns.net.au/subcategory.asp?subcategoryID=155> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "National, State or Local Government Policy or Strategy in relation to Indigenous issues."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "155"^^xsd:token ;
    skos:prefLabel "Policy/Strategy"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:114e4b10-f8d9-5c01-9470-e5036762cb1b
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140125204510/http://atns.net.au/subcategory.asp?subcategoryID=156> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A Plan of Management in relation to the joint management, co-management, or for Indigenous input into, the management of a particular area of land."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "156"^^xsd:token ;
    skos:prefLabel "Plan of Management"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:1eb2e7ab-f69e-50e0-96b3-ae27f43fe296
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The ATNS subcategory 'Research'."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:inScheme cs: ;
    skos:notation "157"^^xsd:token ;
    skos:prefLabel "Research"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:88a6616e-8f95-5953-8f69-3d07e051515c
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140126160616/http://atns.net.au/subcategory.asp?subcategoryID=158> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "This is an area of land or sea over which the Traditional Indigenous Owners have entered into a voluntary agreement for the purposes of promoting biodiversity and cultural resource conservation. The declaration of an Indigenous Protected Area over Indigenous owned lands results in that land being considered as part of the National Reserve System."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "158"^^xsd:token ;
    skos:prefLabel "Indigenous Protected Area"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:66ca48c6-5504-5f8e-9835-c46a3bce657e
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103706/http://atns.net.au/subcategory.asp?subcategoryID=160> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement concluding comprehensive land claims negotiations, and recognising Aboriginal rights and interests to traditional territory."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "160"^^xsd:token ;
    skos:prefLabel "Final Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:7dff9d75-8efe-5518-a99d-54546a46d417
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103717/http://atns.net.au/subcategory.asp?subcategoryID=161> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement which guides and monitors the implementation of a final agreement. The implementation plan sets out the activities and obligations of the parties required to fulfil the agreement. It does not create legal obligations beyond those identified in the final agreement."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "161"^^xsd:token ;
    skos:prefLabel "Implementation Plan (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:fc06dde7-2239-580c-b4b9-09d0f530c888
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160753/http://atns.net.au/subcategory.asp?subcategoryID=162> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement which recognises that the inherent right of self-government is an existing right under section 35 of the of the Constitution Act, 1982. It sets out the self-government arrangements and jurisdictional powers of First Nation Governments. Self-government agreements are often negotiated in conjunction with comprehensive land claims agreements."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "162"^^xsd:token ;
    skos:prefLabel "Self-Government Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:76172eac-f556-58a7-85ae-e9378e301734
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103657/http://atns.net.au/subcategory.asp?subcategoryID=163> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement between the federal and territorial governments transferring province-like powers and responsibilities to the territorial governments. It may cover matters such as legislative authority, development of resource management schemes, financial relationships and human and capital resources transfers."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "163"^^xsd:token ;
    skos:prefLabel "Devolution Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:07dcb544-00ed-512d-9af0-a2d18865d9d3
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160802/http://atns.net.au/subcategory.asp?subcategoryID=164> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement typically negotiated in the context of resource development between a company, various levels of government and the local community. It establishes a framework that promotes the efficient use of resources by Canada, the relevant province or territory, and the local residents. A socio-economic agreement recognises the potential impact of mining or exploration and seeks to promote the economic development and well-being of neighbouring communities."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "164"^^xsd:token ;
    skos:prefLabel "Socio-Economic Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:64c0b91c-926f-5d0c-8368-12601a23c8f2
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103700/http://atns.net.au/subcategory.asp?subcategoryID=165> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement typically negotiated in the context of resource development between a company, the federal government and the relevant provincial or territory government, frequently with the participation of local Aboriginal organisations. Environmental Agreements set out the responsibilities of the parties for the mitigation of any adverse impacts of a given development project."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "165"^^xsd:token ;
    skos:prefLabel "Environmental Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:300b61b1-8d08-5374-9ff8-b28c881f5b11
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103714/http://atns.net.au/subcategory.asp?subcategoryID=166> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A confidential agreement negotiated in the context of resource development between a company, the relevant provincial or territorial government and affected Aboriginal organisations. An IBA establishes the terms under which affected Aboriginal people will benefit from a development project. It is otherwise known as a participation agreement."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "166"^^xsd:token ;
    skos:prefLabel "Impact and Benefits Agreement (IBA) (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:011f1a86-2366-53c2-8f6d-a60006646e79
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103734/http://atns.net.au/subcategory.asp?subcategoryID=167> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Any agreement between mining companies, the two levels of government and local Aboriginal organisations regarding the construction and operation of mining projects."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "167"^^xsd:token ;
    skos:prefLabel "Mining Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:a8368baa-c7b2-5b8f-a071-57fe2a7ec152
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160809/http://atns.net.au/subcategory.asp?subcategoryID=168> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A confidential agreement negotiated in the context of resource development between a company and the relevant provincial and territorial government, with the participation of local Aboriginal organisations. It contains provisions regarding the company’s commitment to support a local industry."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "168"^^xsd:token ;
    skos:prefLabel "Support Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:58e5a837-54f1-58e7-93cb-e780e6096ac2
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103731/http://atns.net.au/subcategory.asp?subcategoryID=169> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement which may constitute the first stage of the negotiation of a final agreement. An MOI sets out the objectives, principles, subject matter and process necessary to guide discussions. It reflects the commitment of the parties to proceed with negotiations."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "169"^^xsd:token ;
    skos:prefLabel "Memorandum of Intent (MOI) (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:0eb5fb8a-c7a0-5513-9544-e257fba66e8c
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160744/http://atns.net.au/subcategory.asp?subcategoryID=170> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement negotiated between a company and local Aboriginal organisations, reflecting the parties’ commitment to increased Aboriginal participation in resource development."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "170"^^xsd:token ;
    skos:prefLabel "Partnership Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:7cfbd20c-917a-5a6c-b2cc-9baa5762381b
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160740/http://atns.net.au/subcategory.asp?subcategoryID=171> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement negotiated between a company and local Aboriginal organisations in the context of natural resource development projects. It may set out the principles to guide the working relationship of the parties, and establish the obligations of the parties regarding employment, training and business opportunities. It is otherwise be known as an Impact and Benefits Agreement."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "171"^^xsd:token ;
    skos:prefLabel "Participation Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:7b236814-e530-5bde-856c-b25535686470
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140303160756/http://atns.net.au/subcategory.asp?subcategoryID=172> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement between a First Nation or Aboriginal government or council and a municipal council for the provision of services to Aboriginal communities. May include services relating to emergency and rescue matters, waste and rubbish removal, regional and local parks, road maintenance, libraries, swimming pool operation, building inspection and dog control."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "172"^^xsd:token ;
    skos:prefLabel "Service Delivery Agreement (Canada)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:fa695837-692e-5ecd-954d-f00c369e7c2e
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140126160508/http://atns.net.au/subcategory.asp?subcategoryID=173> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Aboriginal peoples who reside in the eastern arctic and Arctic Ocean regions of the North West Territories, Northern Quebec and Labrador, formerly known as Eskimo."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "173"^^xsd:token ;
    skos:prefLabel "Inuit of Canada"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:f1e9e6d7-06bd-5773-bbb6-9d851c344924
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140126160524/http://atns.net.au/subcategory.asp?subcategoryID=174> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The Métis Nation evolved in the historic north-west of Canada in the 18th and 19th centuries. Born of a mixture of French and Scottish fur traders and Cree, Ojibwa, Saulteaux, and Assiniboine women, the Métis in the north-west developed as a people, distinct from either Indian or European."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "174"^^xsd:token ;
    skos:prefLabel "Métis of Canada"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:7767aecc-ae64-5c1e-8fe6-b2b68c0cf7e4
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140125204743/http://atns.net.au/subcategory.asp?subcategoryID=175> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A publicly elected government of a province or territory of Canada."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
