    rdfs:isDefinedBy cs: ;
    skos:definition "Aboriginal Land Trusts are statutory bodies created under the Aboriginal Land Act 1991 (Qld). A Land Trust holds land granted under one of the mechanisms in the Act."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
