    skos:prefLabel "Policy/Strategy (South Africa)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:b6d2bb0f-4564-5bb9-b667-3700821f5a5b
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20150330235529/http://www.atns.net.au/subcategory.asp?subcategoryid=321> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A Black Economic Empowerment transaction is the transfer of all or part of the ownership, management or benefits of an enterprise or productive asset to the control of ‘historically disadvantaged South Africans’ (HDSAs), a term which includes black, coloured and Indian South Africans, women and the disabled. These transactions are one aspect of Black Economic Empowerment, a policy designed to ‘increase broad-based and effective participation of black people in the economy’ ( Broad-Based Black Economic Empowerment Act , 2003)."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "321"^^xsd:token ;
    skos:prefLabel "Black Economic Empowerment Transaction (South Africa)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:ccad408c-37fe-5a36-a785-baf3b25cdce9
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20160425181655/http://atns.net.au/subcategory.asp?subcategoryid=324> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement made in accordance with s 83G of the Aboriginal Land Act 1991 (Qld). It concerns the management of land that has been designated a \"national park (Cape York Peninsula Aboriginal land)\" under the Nature Conservation Act 1992 (Qld), as amended by the Cape York Peninsula Heritage Act 2007 (Qld)."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "324"^^xsd:token ;
    skos:prefLabel "Indigenous Management Agreement (Aboriginal Land Act) (Queensland)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:9dcbe1a3-5e12-5b7e-bf28-8badef099c68
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20160425152514/http://atns.net.au/subcategory.asp?subcategoryid=325> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Traditional Use Marine Resource Agreements (TUMRAs) are formal agreements developed by Traditional Owners and the Great Barrier Reef Marine Park Authority to provide for cooperation in the conduct and monitoring of indigenous hunting activities within the Great Barrier Reef Marine Park."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "325"^^xsd:token ;
    skos:prefLabel "Traditional Use Marine Resource Agreement (TUMRA)"@en ;
    skos:topConceptOf cs: ;
.

