.

atns-subcat:c2099cd6-cafc-54bc-9c89-11df0e41766e
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140126160621/http://atns.net.au/subcategory.asp?subcategoryID=71> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A relatively large area of land that is generally owned or leased by the Commonwealth Government in order to preserve its natural, cultural and historic attributes. The legislative basis for a National Park might be, for example, the National Parks and Wildlife Act 1974 (NSW) or the Nature Conservation Act 1992 (Qld)."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "71"^^xsd:token ;
    skos:prefLabel "National Park"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:5b58045c-9ed4-5de5-9ff0-97a1b2ac015f
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20190314235420/https://www.atns.net.au/subcategory.asp?subcategoryID=72> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The activities of a no liability company must be confined to mining. No liability companies are public companies that have no statutory or contractual right to recover unpaid calls on partly paid shares. Such companies have ‘No Liability’ or ‘NL’ in their name."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "72"^^xsd:token ;
    skos:prefLabel "No Liability Company"@en ;
    skos:topConceptOf cs: ;
.

