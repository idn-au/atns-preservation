atns-subcat:5fef068a-6a72-5e16-8885-194d2e021bfe
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140319114201/http://www.atns.net.au/subcategory.asp?subcategoryid=302> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement designed to provide a mechanism for establishing a uniform Commonwealth Government investment strategy across a region with respect to Indigenous Affairs. Such agreements are intended to provide a coordinated response to priorities identified for the region, thus eliminating duplication or gaps. Regional Partnership Agreements (RPAs) form part of the Commonwealth Government's new arrangements for Indigenous Affairs and service delivery. Where States and Territories have agreed, RPAs may also include State and Territory investment. The terms of RPAs will comply with the 'Framework Principles for Government Service Delivery' agreed by the Council of Australian Government in June 2004."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "302"^^xsd:token ;
    skos:prefLabel "Regional Partnership Agreement (RPA)"@en ;
    skos:topConceptOf cs: ;
.

