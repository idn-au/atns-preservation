    skos:prefLabel "Aboriginal and Torres Strait Islander"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:d60a14ab-ee61-558f-bfda-1c3c1c509e65
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20200319040153/https://www.atns.net.au/subcategory.asp?subcategoryID=112> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Prior to the abolition of the Aboriginal and Torres Strait Islander Commission (ATSIC), ICCs were ATSIC and Aboriginal and Torres Strait Islander Services (ATSIS) Regional and State Offices. The ICCs now operate as whole-of-government centres which house staff from a range of departments which deliver services to Indigenous Australians. Prior to the abolition of the Aboriginal and Torres Strait Islander Commission (ATSIC), ICCs were ATSIC and Aboriginal and Torres Strait Islander Services (ATSIS) Regional and State Offices. The ICCs now operate as whole-of-government centres which house staff from a range of departments which deliver services to Indigenous Australians. They operate in 29 locations around Australia and also negotiate Shared Responsibility Agreements (SRAs) with Indigenous communities."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "112"^^xsd:token ;
    skos:prefLabel "Indigenous Coordination Centre (ICC)"@en ;
    skos:topConceptOf cs: ;
.

