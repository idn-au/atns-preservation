.

atns-subcat:fd0b443c-f78b-5840-926a-9b0080a9ebdb
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20110216115005/http://atns.net.au/subcategory.asp?subcategoryID=314> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "‘Land restitution agreement’ is a term which describes the subject matter of an agreement, rather than a specific category of agreement. A land restitution agreement is an agreement which includes the transfer of land to people or communities unfairly deprived of their land under under apartheid-era policies, whether or not that land transfer is associated with a claim under the Restitution of Land Rights Act 1994. Under s 14(3) of that Act, parties to a land restitution claim can reach agreement on the terms of their settlement, and that agreement may then be endorsed by the Land Claims Court as an order of the court."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "314"^^xsd:token ;
    skos:prefLabel "Land Restitution Agreement (South Africa)"@en ;
    skos:topConceptOf cs: ;
.

atns-subcat:53c4c72c-0c84-5487-b3b9-13134a218163
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20080724075416/http://atns.net.au/subcategory.asp?subcategoryID=316> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A Joint Venture Agreement is a commercial agreement creating a business partnership whereby the two or more parties each take up part ownership of a commercial venture."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
    skos:inScheme cs: ;
    skos:notation "316"^^xsd:token ;
    skos:prefLabel "Joint Venture Agreement (South Africa)"@en ;
    skos:topConceptOf cs: ;
.

