atns-subcat:1699fb80-0470-5f04-8e00-5ef955da347c
    a skos:Concept ;
    dcterms:source <https://web.archive.org/web/20140302103623/http://atns.net.au/subcategory.asp?subcategoryID=75> ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An agreement with regard to research protocols and commitments."@en ;
    skos:historyNote "Derived from an ATNS database controlled-list value."@en ;
    skos:historyNote "Definition published by the ATNS project and recovered from the archived ATNS website."@en ;
